{
  "name": "@photoshop-mcp/photoshop-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Photoshop bridge abstraction, protocol types, error model, and mock implementation for PhotoshopMCP",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node ../../scripts/release.mjs check photoshop-bridge"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "photoshop",
    "adobe",
    "mcp",
    "model-context-protocol",
    "uxp",
    "ai"
  ],
  "homepage": "https://github.com/drmedia/photoshop-mcp#readme",
  "bugs": {
    "url": "https://github.com/drmedia/photoshop-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmedia/photoshop-mcp.git",
    "directory": "packages/photoshop-bridge"
  },
  "engines": {
    "node": ">=22.12"
  }
}
