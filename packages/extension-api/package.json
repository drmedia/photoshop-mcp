{
  "name": "@photoshop-mcp/extension-api",
  "version": "0.1.0",
  "type": "module",
  "description": "Public API surface for PhotoshopMCP extensions",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node ../../scripts/release.mjs check extension-api"
  },
  "dependencies": {
    "@photoshop-mcp/photoshop-bridge": "0.1.0",
    "@photoshop-mcp/photoshop-tools": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "photoshop",
    "adobe",
    "mcp",
    "model-context-protocol",
    "uxp",
    "ai"
  ],
  "homepage": "https://github.com/drmedia/photoshop-mcp#readme",
  "bugs": {
    "url": "https://github.com/drmedia/photoshop-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmedia/photoshop-mcp.git",
    "directory": "packages/extension-api"
  },
  "engines": {
    "node": ">=22.12"
  }
}
