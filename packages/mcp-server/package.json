{
  "name": "photoshop-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server that lets AI clients inspect and edit Adobe Photoshop documents through a fixed, permission-gated set of tools",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "photoshop-mcp": "./bin/photoshop-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node ../../scripts/release.mjs check mcp-server"
  },
  "dependencies": {
    "@photoshop-mcp/mcp-core": "0.1.0",
    "@photoshop-mcp/photoshop-bridge": "0.1.0",
    "@photoshop-mcp/photoshop-tools": "0.1.0"
  },
  "keywords": [
    "photoshop",
    "adobe",
    "mcp",
    "model-context-protocol",
    "uxp",
    "ai"
  ],
  "homepage": "https://github.com/drmedia/photoshop-mcp#readme",
  "bugs": {
    "url": "https://github.com/drmedia/photoshop-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmedia/photoshop-mcp.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=22.12"
  }
}
