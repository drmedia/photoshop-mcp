{
  "providers": [
    {
      "id": "graxpert",
      "capability": "gradientRemoval",
      "label": "GraXpert 3.0.2 (background-extraction)",
      "executable": "C:/Users/<사용자>/AppData/Local/Programs/GraXpert/GraXpert.exe",
      "args": [
        "-cmd",
        "background-extraction",
        "{{input}}",
        "-cli",
        "-gpu",
        "{{gpu}}",
        "-correction",
        "{{correction}}",
        "-smoothing",
        "{{smoothing}}",
        "-output",
        "{{output}}"
      ],
      "params": {
        "correction": {
          "type": "enum",
          "values": ["Subtraction", "Division"],
          "default": "Subtraction"
        },
        "smoothing": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.5
        },
        "gpu": {
          "type": "boolean",
          "default": true
        }
      },
      "outputSuffix": ".fits",
      "convert": "fitsToTiff",
      "timeoutMs": 1800000,
      "priority": 10
    },
    {
      "id": "starnet2",
      "capability": "starRemoval",
      "label": "StarNet++ v2",
      "executable": "C:/Program Files/StarNet2/bin/starnet2.exe",
      "args": [
        "--input",
        "{{input}}",
        "--output",
        "{{output}}",
        "--unscreen",
        "{{output.stars}}",
        "--stride",
        "{{stride}}",
        "--machine-progress"
      ],
      "outputs": {
        "stars": {
          "description": "별만 남긴 이미지. restore_stars 에 쓴다."
        }
      },
      "timeoutMs": 1800000,
      "priority": 10,
      "params": {
        "stride": {
          "type": "number",
          "min": 2,
          "max": 512,
          "default": 256
        }
      }
    },
    {
      "id": "bxt",
      "capability": "deconvolution",
      "label": "BlurXTerminator (RC-Astro CLI 2.6)",
      "executable": "C:/Program Files/RC-Astro/CLI/rc-astro.exe",
      "args": [
        "bxt",
        "{{input}}",
        "--sharpen-stars={{sharpenStars}}",
        "--sharpen-nonstellar={{sharpenNonstellar}}",
        "--adjust-star-halos={{starHalos}}",
        "--lunar-planetary={{lunarPlanetary}}",
        "--correct-only={{correctOnly}}",
        "--output",
        "{{output}}",
        "--overwrite"
      ],
      "params": {
        "sharpenStars": {
          "type": "number",
          "min": 0,
          "max": 0.7,
          "default": 0.5
        },
        "sharpenNonstellar": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.5
        },
        "starHalos": {
          "type": "number",
          "min": -0.5,
          "max": 0.5,
          "default": 0
        },
        "lunarPlanetary": {
          "type": "boolean",
          "default": false
        },
        "correctOnly": {
          "type": "boolean",
          "default": false
        }
      },
      "timeoutMs": 1800000,
      "priority": 10
    },
    {
      "id": "nxt",
      "capability": "noiseReduction",
      "label": "NoiseXTerminator (RC-Astro CLI 2.6)",
      "executable": "C:/Program Files/RC-Astro/CLI/rc-astro.exe",
      "args": [
        "nxt",
        "{{input}}",
        "--denoise-intensity={{denoiseIntensity}}",
        "--denoise-color={{denoiseColor}}",
        "--iterations={{iterations}}",
        "--output",
        "{{output}}",
        "--overwrite"
      ],
      "params": {
        "denoiseIntensity": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.9
        },
        "denoiseColor": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 0.9
        },
        "iterations": {
          "type": "number",
          "min": 1,
          "max": 5,
          "default": 2
        }
      },
      "timeoutMs": 1800000,
      "priority": 10
    },
    {
      "id": "sxt",
      "capability": "starRemoval",
      "label": "StarXTerminator (RC-Astro CLI 2.6)",
      "executable": "C:/Program Files/RC-Astro/CLI/rc-astro.exe",
      "args": [
        "sxt",
        "{{input}}",
        "--output-stars=true",
        "--unscreen={{unscreen}}",
        "--output",
        "{{output}}",
        "--overwrite"
      ],
      "params": {
        "unscreen": {
          "type": "boolean",
          "default": false
        }
      },
      "timeoutMs": 1800000,
      "priority": 20
    }
  ]
}
