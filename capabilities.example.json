{
  "providers": [
    {
      "id": "graxpert",
      "capability": "gradientRemoval",
      "label": "GraXpert",
      "executable": "C:/Program Files/GraXpert/GraXpert.exe",
      "args": ["-cli", "-correction", "{{correction}}", "-output", "{{output}}", "{{input}}"],
      "params": {
        "correction": {
          "type": "enum",
          "values": ["Subtraction", "Division"],
          "default": "Subtraction"
        }
      },
      "timeoutMs": 900000,
      "priority": 10
    },
    {
      "id": "starnet2",
      "capability": "starRemoval",
      "label": "StarNet++ v2",
      "executable": "C:/Program Files/StarNet2/StarNetv2CLI.exe",
      "args": ["{{input}}", "{{output}}", "{{stride}}"],
      "params": {
        "stride": {
          "type": "number",
          "integer": true,
          "min": 32,
          "max": 256,
          "default": 128
        }
      },
      "timeoutMs": 1800000,
      "priority": 10
    }
  ]
}
