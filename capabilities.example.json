{
  "providers": [
    {
      "id": "graxpert",
      "capability": "gradientRemoval",
      "label": "GraXpert 3.0.2 (background-extraction)",
      "executable": "C:/Users/drmedia/AppData/Local/Programs/GraXpert/GraXpert.exe",
      "args": [
        "-cmd",
        "background-extraction",
        "{{input}}",
        "-cli",
        "-gpu",
        "{{gpu}}",
        "-correction",
        "{{correction}}",
        "-smoothing",
        "{{smoothing}}",
        "-output",
        "{{output}}"
      ],
      "params": {
        "correction": {
          "type": "enum",
          "values": ["Subtraction", "Division"],
          "default": "Subtraction"
        },
        "smoothing": { "type": "number", "min": 0, "max": 1, "default": 0.5 },
        "gpu": { "type": "boolean", "default": true }
      },
      "outputSuffix": ".fits",
      "convert": "fitsToTiff",
      "timeoutMs": 1800000,
      "priority": 10
    },
    {
      "id": "starnet2",
      "capability": "starRemoval",
      "label": "StarNet++ v2",
      "executable": "C:/Program Files/StarNet2/bin/starnet2.exe",
      "args": [
        "--input",
        "{{input}}",
        "--output",
        "{{output}}",
        "--unscreen",
        "{{output.stars}}",
        "--machine-progress"
      ],
      "outputs": {
        "stars": { "description": "별만 남긴 이미지. restore_stars 에 쓴다." }
      },
      "timeoutMs": 1800000,
      "priority": 10
    },
    {
      "id": "bxt",
      "capability": "deconvolution",
      "label": "BlurXTerminator (RC-Astro CLI)",
      "executable": "C:/Program Files/RC-Astro/CLI/rc-astro.exe",
      "args": [
        "bxt",
        "{{input}}",
        "--sharpen-nonstellar",
        "{{nonstellar}}",
        "--output",
        "{{output}}",
        "--overwrite"
      ],
      "params": {
        "nonstellar": { "type": "number", "min": 0, "max": 1, "default": 0.5 }
      },
      "timeoutMs": 1800000,
      "priority": 10
    }
  ]
}
