{
  "manifestVersion": 4,
  "id": "com.drmedia.photoshopmcp",
  "name": "Photoshop MCP",
  "version": "0.1.0",
  "main": "dist/index.js",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark"],
      "species": ["generic"]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-light.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "photoshopMcpPanel",
      "label": {
        "default": "Photoshop MCP"
      },
      "minimumSize": {
        "width": 200,
        "height": 110
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 220
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 300
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark"],
          "species": ["generic"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["localhost", "127.0.0.1"]
    }
  }
}
