{
  "manifestVersion": 4,
  "id": "com.drmedia.photoshopmcp",
  "name": "Photoshop MCP",
  "version": "0.1.0",
  "main": "dist/index.js",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "photoshopMcpPanel",
      "label": {
        "default": "Photoshop MCP"
      },
      "minimumSize": {
        "width": 200,
        "height": 80
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 200
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 240
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["localhost", "127.0.0.1"]
    }
  }
}
